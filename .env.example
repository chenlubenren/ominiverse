# Optional configuration: copy this file to .env.local and fill only what you need.
# No API key is required for the basic scenes and existing models.
# .env.local only loads the fields shown below. Process environment takes priority.
# Other settings must be supplied through the process environment or a systemd
# EnvironmentFile. See docs/部署.md for the complete configuration table.

# Event and robot interpretation.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# Optional Anthropic-compatible robot customization provider.
# FABLE_API_KEY=
# FABLE_BASE_URL=https://api.example.com/v1
# FABLE_MODEL=
# FABLE_ALLOW_MODEL_ALIAS=0

# Optional asset service.
# AHOLO_API_KEY=

# Full path to Blender, needed for new robot model processing.
# BLENDER_PATH=/usr/local/bin/blender
